MONGODB_URI=mongodb+srv://<user>:<pass>@cluster.mongodb.net/acm23
ADMIN_PASSWORD=your-admin-password-here
BLOB_READ_WRITE_TOKEN=vercel_blob_xxxxxxxxxxxx

# Email — Gmail SMTP via App Password (replaces Resend; see issue #2)
# Requires 2-Step Verification on the Gmail account, then an App Password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=acm23@vnu.edu.vn
SMTP_PASS=your-16-char-app-password
# From must match SMTP_USER (or a verified alias) or Gmail rejects the send.
MAIL_FROM=ACM23 Organizing Committee <acm23@vnu.edu.vn>

# RESEND_API_KEY — deprecated, removed when the Gmail SMTP switch lands (issue #6)
